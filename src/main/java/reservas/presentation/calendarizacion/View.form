<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="reservas.presentation.calendarizacion.View">
  <grid id="27dc6" binding="panel" layout-manager="GridLayoutManager" row-count="2" column-count="1" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
    <margin top="0" left="0" bottom="0" right="0"/>
    <constraints>
      <xy x="20" y="20" width="700" height="450"/>
    </constraints>
    <properties/>
    <border type="none"/>
    <children>
      <grid id="a1a01" binding="filtrosPanel" layout-manager="FlowLayout" hgap="5" vgap="5" flow-align="1">
        <constraints>
          <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="3" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties/>
        <border type="none" title="Filtros"/>
        <children>
          <component id="b1b02" class="javax.swing.JLabel">
            <constraints/>
            <properties>
              <text value="Fecha:"/>
            </properties>
          </component>
          <component id="c1c03" class="com.github.lgooddatepicker.components.DatePicker" binding="fechaPicker">
            <constraints/>
            <properties/>
          </component>
          <component id="d1d04" class="javax.swing.JLabel">
            <constraints/>
            <properties>
              <text value="Categoría:"/>
            </properties>
          </component>
          <component id="e1e05" class="javax.swing.JComboBox" binding="categoriaCbx">
            <constraints/>
            <properties>
              <model/>
            </properties>
          </component>
          <component id="f1f06" class="javax.swing.JButton" binding="cargarBtn">
            <constraints/>
            <properties>
              <text value="Cargar"/>
            </properties>
          </component>
          <component id="g1g07" class="javax.swing.JButton" binding="imprimirBtn">
            <constraints/>
            <properties>
              <text value="Imprimir"/>
            </properties>
          </component>
        </children>
      </grid>
      <grid id="h1h08" binding="listadoPanel" layout-manager="GridLayoutManager" row-count="1" column-count="1" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
        <margin top="0" left="0" bottom="0" right="0"/>
        <constraints>
          <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="3" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties/>
        <border type="none" title="Calendarización de recursos"/>
        <children>
          <scrollpane id="i1i09">
            <constraints>
              <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="7" hsize-policy="7" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties/>
            <border type="none"/>
            <children>
              <component id="j1j10" class="javax.swing.JTable" binding="calendarioTable">
                <constraints/>
                <properties/>
              </component>
            </children>
          </scrollpane>
        </children>
      </grid>
    </children>
  </grid>
</form>
